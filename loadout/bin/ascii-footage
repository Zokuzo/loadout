#!/usr/bin/env python3
"""Turns a slot's footage into ASCII grids the Halo figures play: bin/ascii-footage <assets>/<slot> [rows] [clip]

For each clip `<slot>/<clip>/NNN.png` it writes `<slot>/<clip>/ascii.json`: {columns, rows, frames: [{glyphs, fg}]},
`glyphs` one string of columns x rows characters, `fg` a hex colour per cell ('' where the cell is blank).
Each cell takes the character whose drawn shape is nearest the picture under it (3 x 4 patches, measured on the
terminal's own font), its colour the picture's there; a cell keeps its character from one frame to the next unless
another fits clearly better, so the figure does not shimmer. Needs Pillow and numpy.
Where `hyperframes` and `ffmpeg` are found, the character is first cut out of its background (a local model;
the mattes are kept in `<clip>/cut/NNN.png`), so only the character is drawn and the pane's ground shows around it.
"""
import json, os, shutil, subprocess, sys, tempfile
import numpy as np
from PIL import Image, ImageDraw, ImageFilter, ImageFont

FONT = '/usr/share/fonts/truetype/jetbrains-mono/JetBrainsMono-Regular.ttf'
CW, CH = 12, 24  # a cell in pixels: half as wide as tall, as the pane's cells (halo.ts CELL)
PX, PY = 3, 4  # patches per cell
# Strokes and marks, no letters: a letter reads as a word, not as a shade or an edge.
GLYPHS = ' .,:;\'"-_=+*~^<>/\\|()[]{}!?#%@&$08oOcvx'
KEEP = float(os.environ.get('KEEP', 0.3))  # how much better another character must fit before a cell changes it
GAMMA, EDGE = float(os.environ.get('GAMMA', 1.8)), float(os.environ.get('EDGE', 0.4))
GROUND = 18  # luminance (0-255) under which the picture is the pane's ground


def glyph_table():
    font = ImageFont.truetype(FONT, 20)
    rows = []
    for g in GLYPHS:
        im = Image.new('L', (CW, CH), 0)
        ImageDraw.Draw(im).text((0, 0), g, font=font, fill=255)
        rows.append(patches(np.asarray(im, np.float32) / 255, 1, 1)[0, 0])
    return np.stack(rows)  # glyph x (PX*PY)


def patches(ink, cols, rows):
    """The mean ink of each cell's PX x PY patches: rows x cols x (PX*PY)."""
    a = ink.reshape(rows, PY, CH // PY, cols, PX, CW // PX).mean(axis=(2, 5))
    return a.transpose(0, 2, 1, 3).reshape(rows, cols, PX * PY)


def cut(d, frames):
    """The clip's mattes, made once: the character opaque, its background clear. None where they cannot be made."""
    out = f'{d}/cut'
    if os.path.isdir(out) and len(os.listdir(out)) == len(frames): return out
    if not (shutil.which('hyperframes') and shutil.which('ffmpeg')): return None
    with tempfile.TemporaryDirectory() as tmp:
        run = lambda *a: subprocess.run(a, check=True, capture_output=True)
        run('ffmpeg', '-y', '-framerate', '30', '-start_number', '0', '-i', f'{d}/%03d.png', '-c:v', 'libx264', '-crf', '10', '-pix_fmt', 'yuv420p', f'{tmp}/in.mp4')
        run('hyperframes', 'remove-background', f'{tmp}/in.mp4', '-o', f'{tmp}/out.mov')
        os.makedirs(out, exist_ok=True)
        run('ffmpeg', '-y', '-i', f'{tmp}/out.mov', '-vf', 'alphaextract', '-start_number', '0', f'{out}/%03d.png')
    return out


def prepare(path, matte, cols, rows):
    """The frame at the grid's size in pixels, its light spread over the whole range, edges sharpened; and how much of it is the character."""
    size = (cols * CW, rows * CH)
    rgb = np.asarray(Image.open(path).convert('RGB').resize(size, Image.LANCZOS), np.float32)
    alpha = np.ones(size[::-1], np.float32) if matte is None else np.asarray(Image.open(matte).convert('L').resize(size, Image.LANCZOS), np.float32) / 255
    lum = rgb @ np.array([0.299, 0.587, 0.114], np.float32)
    lo, hi = np.percentile(lum[alpha > 0.5] if (alpha > 0.5).any() else lum, [2, 99.5])
    lum = np.clip((lum - lo) / max(1.0, hi - lo), 0, 1)
    blur = np.asarray(Image.fromarray((lum * 255).astype(np.uint8)).filter(ImageFilter.GaussianBlur(CW)), np.float32) / 255
    lum = np.clip(lum + 0.8 * (lum - blur), 0, 1)  # local contrast: what stands out of its surroundings stands out more
    # The edges, of the light and of the figure itself: dark hair or a black visor are drawn by their outline, not lost in the ground.
    gy, gx = np.gradient(lum * 0.6 + alpha * 0.4)
    edge = np.clip(np.hypot(gx, gy) * CW * EDGE, 0, 1)
    lum = np.maximum(np.maximum(lum ** GAMMA, 0.1), edge) * alpha  # (the gamma keeps the heavy characters for the highlights)
    return rgb, lum, alpha


def convert(frames, mattes, cols, rows, table):
    norms = (table ** 2).sum(1)
    out, before = [], None
    for path, matte in zip(frames, mattes):
        rgb, lum, alpha = prepare(path, matte, cols, rows)
        want = patches(lum, cols, rows)  # rows x cols x k
        dist = norms[None, None, :] - 2 * want @ table.T + (want ** 2).sum(-1, keepdims=True)
        best = dist.argmin(-1)
        if before is not None:
            kept = np.take_along_axis(dist, before[..., None], -1)[..., 0]
            best = np.where(kept <= dist.min(-1) + KEEP, before, best)
        before = best
        mean = rgb.reshape(rows, CH, cols, CW, 3).mean(axis=(1, 3))
        cover = alpha.reshape(rows, CH, cols, CW).mean(axis=(1, 3))
        glow = mean / np.maximum(1, mean.max(-1, keepdims=True)) * 255  # a thin stroke shows the colour at full light
        glyphs, fg = [], []
        for y in range(rows):
            for x in range(cols):
                g = GLYPHS[best[y, x]]
                if cover[y, x] < 0.25 or (mean[y, x].max() < GROUND and cover[y, x] < 0.6): g = ' '
                glyphs.append(g)
                fg.append('' if g == ' ' else '%02x%02x%02x' % tuple(int(v) for v in glow[y, x]))
        out.append({'glyphs': ''.join(glyphs), 'fg': fg})
    return out


def main():
    slot = sys.argv[1].rstrip('/')
    rows = int(sys.argv[2]) if len(sys.argv) > 2 else 28
    w, h = 400, 340  # the feed's shape (reel.ts FEED_SHAPE)
    cols = round(rows * (w / h) * CH / CW)
    table = glyph_table()
    for clip in sys.argv[3:4] or sorted(os.listdir(slot)):
        d = f'{slot}/{clip}'
        frames = sorted(f'{d}/{f}' for f in os.listdir(d) if f.endswith('.png')) if os.path.isdir(d) else []
        if not frames: continue
        where = cut(d, frames)
        mattes = [None] * len(frames) if where is None else [f'{where}/{os.path.basename(f)}' for f in frames]
        json.dump({'columns': cols, 'rows': rows, 'frames': convert(frames, mattes, cols, rows, table)}, open(f'{d}/ascii.json', 'w'), separators=(',', ':'))
        print(f'{clip}: {len(frames)} frames, {cols}x{rows}{"" if where else ", not cut out"}', flush=True)


if __name__ == '__main__':
    main()
